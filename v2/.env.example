# LeadHarvest — Environment Configuration
# Copy this to .env and adjust as needed.
# No values are sent externally — everything stays on your machine.

# Host and port for the backend server
HOST=127.0.0.1
PORT=8000

# Maximum concurrent browser contexts (keep at 1 for stable scraping)
SCRAPER_CONCURRENCY=1

# Default max results per query if not specified in request
SCRAPER_DEFAULT_MAX_RESULTS=60

# Path to exports directory (relative to backend/)
EXPORTS_DIR=../exports

# Path to logs directory (relative to backend/)
LOGS_DIR=../logs
